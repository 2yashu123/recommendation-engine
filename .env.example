# Database Connection (SQLite for local dev; switch to PostgreSQL when Docker is enabled)
DATABASE_URL=sqlite:///./recommendation.db
# PostgreSQL example (for production / Docker):
# DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/recommendation_engine

# Docker PostgreSQL Credentials
DB_PASSWORD=your_secure_password_here
POSTGRES_USER=postgres
POSTGRES_DB=recommendation_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
